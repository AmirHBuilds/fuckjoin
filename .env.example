# https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Optional. Default: telegram-automation.session (do not commit it).
SESSION_NAME=telegram-automation

# Wait after resolved channel joins before re-sending /start. Range: 0-60; default: 2.
RETRY_DELAY_SECONDS=2

# Delay between successful channel joins to avoid rate limits. Default: 3.
JOIN_PACING_DELAY_SECONDS=3

# Maximum automated channels before cleaning up the oldest half. Default: 100.
MAX_JOINED_CHANNELS=100

# Optional: numeric Telegram IDs permitted to privately send /get requests to this account.
# Comma-separated. Leave empty to allow all private users or only yourself.
ALLOWED_REQUESTER_IDS=

# Comma-separated list of transient / spinner texts to ignore from bots.
TRANSIENT_TEXTS=...,Please wait,Processing...,⏳,⌛

# Comma-separated list of blocked words. Messages containing these will NOT be forwarded.
# Note: Media captions are exempt from this block.
BLOCKED_TEXT_WORDS=advertisement,sponsor,promo,join my channel
