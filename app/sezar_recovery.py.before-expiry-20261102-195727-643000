"""Conservative restart-on-stale-response support for Sezar/fuckjoin.

A recovery is attempted from the ORIGINAL link only when no media was delivered.
The code waits for Telegram's FloodWait rather than bypassing it.
"""
from __future__ import annotations

import asyncio
import logging
import os
import time
from contextvars import ContextVar
from typing import Any, Awaitable

# A per-worker-task flag. None means that we're outside a delivery attempt.
_waited: ContextVar[bool | None] = ContextVar('sezar_delivery_waited', default=None)


def mark_explicit_wait(duration: float) -> None:
    if duration > 10 and _waited.get() is not None:
        _waited.set(True)


async def measure_telegram_call(aw: Awaitable[Any]) -> Any:
    """Record unexpectedly slow Telegram calls (including automatic Telethon sleeps)."""
    start = time.monotonic()
    try:
        return await aw
    finally:
        if time.monotonic() - start > 10 and _waited.get() is not None:
            _waited.set(True)


def _limit(name: str, default: int, min_value: int, max_value: int) -> int:
    try:
        return max(min_value, min(max_value, int(os.environ.get(name, default))))
    except (ValueError, TypeError):
        return default


async def deliver_with_retries(deliver, *, progress, cancel_event, cancel_error, **kwargs):
    """Retry original link (at most 3 times); never retry after media was sent.

    Retries long-delayed failed flows and selected transient exceptions. The
    same cancellation event and recipient are used for every attempt.
    """
    attempts = _limit('RECOVERY_MAX_ATTEMPTS', 3, 1, 3)
    threshold = _limit('RECOVERY_RESTART_AFTER_SECONDS', 10, 10, 3600)
    status, messages = '[✗] No media delivered', []
    for attempt in range(1, attempts + 1):
        if cancel_event.is_set():
            raise cancel_error()
        token = _waited.set(False)
        start = time.monotonic()
        retryable_error = False
        try:
            try:
                status, messages = await deliver(progress=progress, cancel_event=cancel_event, **kwargs)
            except (TimeoutError, TypeError) as exc:
                retryable_error = True
                logging.exception('Transient Telegram flow error on attempt %d', attempt)
                status = f'[✗] Flow error: {type(exc).__name__}'
                messages = []
            except Exception as exc:
                # Longer-than-threshold FloodWaits can be raised by Telethon.
                # Respect the server's timer, or stop without retrying.
                if type(exc).__name__ != 'FloodWaitError' or not hasattr(exc, 'seconds'):
                    raise
                seconds = max(0, int(exc.seconds))
                maximum = _limit('RECOVERY_MAX_FLOODWAIT_SECONDS', 900, 30, 3600)
                if seconds > maximum:
                    return f'[✗] Telegram requires {seconds}s of cooldown; task paused without retry.', []
                await progress.report(f'[⏳] Telegram cooldown {seconds}s; will restart original link afterward')
                mark_explicit_wait(seconds)
                try:
                    await asyncio.wait_for(cancel_event.wait(), timeout=seconds + 1)
                    raise cancel_error()
                except asyncio.TimeoutError:
                    pass
                retryable_error = True
                status = '[✗] Telegram cooldown ended before media delivery'
                messages = []
        finally:
            flagged = _waited.get()
            _waited.reset(token)
        if messages:
            return status, messages  # Never resend media after success.
        slow_or_stale = bool(flagged) or time.monotonic() - start >= threshold
        if attempt == attempts or not (slow_or_stale or retryable_error):
            return status, []
        await progress.report(
            f'[↻] No media received after a delayed/failed step. '
            f'Restarting from original link ({attempt + 1}/{attempts})...'
        )
        # Avoid hammering the third-party bot, and remain cancellable.
        try:
            await asyncio.wait_for(cancel_event.wait(), timeout=3.0)
            raise cancel_error()
        except asyncio.TimeoutError:
            pass
    return status, []
